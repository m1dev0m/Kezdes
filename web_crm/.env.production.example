# Production env (example)
# Build-time variables used by Vite.
# If web and API are served from the same domain behind a reverse proxy,
# these can be omitted and the frontend will use `${window.location.origin}/api/v1`
# and the current host for WebSocket connections.

VITE_API_URL=https://api.kezdes.kz/api/v1
VITE_WS_URL=wss://api.kezdes.kz
