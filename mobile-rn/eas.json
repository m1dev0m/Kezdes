{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_DEBUG_LOGS": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kezdes.kz/api/v1",
        "EXPO_PUBLIC_DEBUG_LOGS": "false"
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://kezdes.kz/api/v1",
        "EXPO_PUBLIC_DEBUG_LOGS": "false"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
