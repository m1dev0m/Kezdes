# Mobile (Expo) Environment Configuration

# API Base URL
# Android emulator (from container/Android emulator to host):   http://10.0.2.2:8000/api/v1
# iOS simulator (from macOS VM to host):                       http://localhost:8000/api/v1
# Real device on same network:                                  http://YOUR_PC_IP:8000/api/v1
#
# IMPORTANT:
# - For Expo Go on a real iPhone, DO NOT hardcode 10.0.2.2 or localhost here.
# - If EXPO_PUBLIC_API_URL is not set, the app will auto-detect your dev host IP via Expo hostUri.
#
# Optional override (uncomment and set your value if needed):
# EXPO_PUBLIC_API_URL=http://YOUR_PC_IP:8000/api/v1

# Optional: Sentry error reporting
EXPO_PUBLIC_SENTRY_DSN=

# Optional: Feature flags
EXPO_PUBLIC_DEBUG_LOGS=true
