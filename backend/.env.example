# Backend
DEBUG=True
SECRET_KEY=your-insecure-dev-key-please-change-32-chars-minimum

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kezdes_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//

# API/WS URLs (for frontend to reach backend)
# Change these if running backend on different host/port
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000

# CORS/Allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1,*.local
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173,https://kezdes.kz,https://www.kezdes.kz
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000,http://localhost:5000
ENABLE_API_DOCS=True
TIME_ZONE=Asia/Almaty
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PROTO=False

# Production behind nginx / reverse proxy:
# USE_X_FORWARDED_HOST=True
# USE_X_FORWARDED_PROTO=True
# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=https://kezdes.kz,https://www.kezdes.kz
# CSRF_TRUSTED_ORIGINS=https://kezdes.kz,https://www.kezdes.kz
# ENABLE_API_DOCS=False

# Auth
JWT_SIGNING_KEY=your-jwt-signing-key-min-32-chars

# Optional: Third-party services
TWOGIS_API_KEY=
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
POSTGRES_PASSWORD=postgres

# Email (for production)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# OTP (email confirmation)
# For local dev you can keep it off; for production keep it on.
REQUIRE_EMAIL_OTP=False
OTP_EXPIRE_MINUTES=10

# Throttling
THROTTLE_ANON_RATE=100/min
THROTTLE_USER_RATE=1000/min
